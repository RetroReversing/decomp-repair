{
  "schema": 1,
  "id": "abs_idiom",
  "description": "A hand-written absolute value (`v = x; if (v < 0) { v = -v; }`) as the C library's abs(): GCC 2.8 compiles abs(x) to bltzl with the negu in its delay slot.",
  "families": [
    "abs_idiom",
    "abs_idiom_one"
  ],
  "archs": [
    "mips"
  ],
  "order": 63,
  "gate": [
    {
      "asm_has": [
        "negu",
        "neg",
        {
          "op": [
            "subu",
            "sub"
          ],
          "argc": 3,
          "arg1": "$zero"
        }
      ]
    }
  ],
  "sites": [
    {
      "match": "^(?P<lead>[ \\t]*)(?P<var>@IDENT@)\\s*=\\s*(?P<expr>[^;{}]+?)\\s*;[ \\t]*\\n[ \\t]*if\\s*\\(\\s*(?P<test>[^;{}]+?)\\s*<\\s*0\\s*\\)\\s*\\{\\s*(?P=var)\\s*=\\s*-\\s*(?P=var)\\s*;\\s*\\}(?!\\s*else\\b)",
      "where": [
        {
          "group_equals_any": {
            "group": "test",
            "of": [
              "var",
              "expr"
            ]
          }
        },
        {
          "declared_type": {
            "group": "var",
            "kind": "integer"
          }
        }
      ],
      "replace": "{lead}{var} = abs({expr:strip});"
    },
    {
      "match": "^(?P<lead>[ \\t]*)if\\s*\\(\\s*(?P<var>@IDENT@)\\s*<\\s*0\\s*\\)\\s*\\{\\s*(?P=var)\\s*=\\s*-\\s*(?P=var)\\s*;\\s*\\}(?!\\s*else\\b)",
      "where": [
        {
          "declared_type": {
            "group": "var",
            "kind": "integer"
          }
        }
      ],
      "replace": "{lead}{var} = abs({var});"
    }
  ],
  "prepend_unless_declared": {
    "pattern": "^[ \\t]*(?:extern[ \\t]+)?(?:int|s32)[ \\t]+abs\\s*\\(",
    "text": "int abs(int);\n"
  },
  "children": {
    "all": "abs_idiom",
    "each": {
      "family": "abs_idiom_one",
      "when_sites_over": 1,
      "max": 7
    }
  }
}
