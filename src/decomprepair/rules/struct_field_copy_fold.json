{
  "schema": 1,
  "id": "struct_field_copy_fold",
  "description": "A struct assignment from a field of a global array element (`d = A[i].f;`) written `d = *&A[i].f;`: GCC 2.8 then folds the field offset into the symbol (base A+off, block-move offsets from 0) instead of keeping it in every load of the copy.",
  "families": [
    "struct_field_copy_fold",
    "struct_field_copy_fold_one"
  ],
  "archs": [
    "mips"
  ],
  "order": 640,
  "gate": [
    {
      "asm_has": [
        "lw"
      ]
    }
  ],
  "sites": [
    {
      "match": "^(?P<lead>[ \\t]*)(?P<dst>[A-Za-z_][^;=!<>&|\\n(){}]*?)\\s*=\\s*(?P<arr>@IDENT@)\\s*\\[(?P<idx>[^\\[\\];\\n]+)\\]\\s*\\.\\s*(?P<field>@IDENT@)\\s*;",
      "replace": "{lead}{dst:strip} = *&{arr}[{idx:strip}].{field};"
    }
  ],
  "children": {
    "all": "struct_field_copy_fold",
    "each": {
      "family": "struct_field_copy_fold_one",
      "when_sites_over": 1,
      "max": 7
    }
  }
}
